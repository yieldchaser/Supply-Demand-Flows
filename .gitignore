# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Secrets — NEVER commit
.env
.env.*
secrets.yaml
*.secrets

# Raw ingested data — gitignored, re-fetchable from source APIs
data/raw/

# Health observability — committed so we can track system health over time
!data/health/
!data/health/*.json

# Curated canonical data — committed as source of truth for dashboard
!data/curated/
!data/curated/**/*.parquet

# Dashboard bundle — committed for Pages.
# Only the stable (hashless) entrypoints are tracked. The cache-busted
# hash-suffixed artifacts (bundle.{HASH}.json, src.{source}.{HASH}.json,
# index.{HASH}.json) are regenerated by the publisher on every deploy and are
# gitignored — they were previously force-tracked via `!docs/data/*.json`,
# which accumulated 4.6 GB / 144 hashes in the repo (2026-08-25 graveyard fix).
!docs/data/
!docs/data/bundle.json
!docs/data/manifest.json
# Everything else under docs/data is a build artifact and intentionally ignored.
docs/data/*.json
# ...except the two stable entrypoints above (negations win by last-match).
!docs/data/bundle.json
!docs/data/manifest.json

# Alert idempotency state — committed so GHA jobs deduplicate across runs
!data/sent_alerts.json

# Playwright
.playwright/
playwright-report/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
